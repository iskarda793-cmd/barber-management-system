# Copy to .env for local overrides (docker compose reads it automatically).
# Never commit the real .env file.

# --- Local (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=barberdb

# --- Option 1: Azure Container Apps -> Azure PostgreSQL Flexible Server ---
# DB_HOST=<server-name>.postgres.database.azure.com
# DB_PORT=5432
# DB_NAME=barberdb
# DB_USER=<admin-user>
# DB_PASSWORD=<set as an ACA secret, not a plain variable>
# DB_SSLMODE=require
# APP_PLATFORM=Azure Container Apps

# --- Option 2: Render Web Service -> Render PostgreSQL (Internal Database URL) ---
# DATABASE_URL=postgresql://user:password@dpg-xxxxxxxx-a/barberdb
# APP_PLATFORM=Render
